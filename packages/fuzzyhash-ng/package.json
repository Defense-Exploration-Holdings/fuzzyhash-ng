{
  "name": "fuzzyhash-ng",
  "version": "0.3.2",
  "description": "ssdeep, TLSH, imphash, telfhash, image hashes, MinHash, SimHash, LZJD and Nilsimsa, compiled from Zig to WebAssembly",
  "keywords": [
    "ssdeep",
    "tlsh",
    "fuzzy hash",
    "ctph",
    "similarity digest",
    "dfir",
    "imphash",
    "telfhash",
    "phash",
    "minhash",
    "simhash",
    "lzjd",
    "nilsimsa",
    "webassembly"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Defense-Exploration-Holdings/fuzzyhash-ng.git",
    "directory": "packages/fuzzyhash-ng"
  },
  "bugs": "https://github.com/Defense-Exploration-Holdings/fuzzyhash-ng/issues",
  "homepage": "https://github.com/Defense-Exploration-Holdings/fuzzyhash-ng#readme",
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.d.mts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./ssdeep": {
      "types": "./src/ssdeep.d.mts",
      "default": "./src/ssdeep.mjs"
    },
    "./tlsh": {
      "types": "./src/tlsh.d.mts",
      "default": "./src/tlsh.mjs"
    },
    "./imphash": {
      "types": "./src/imphash.d.mts",
      "default": "./src/imphash.mjs"
    },
    "./telfhash": {
      "types": "./src/telfhash.d.mts",
      "default": "./src/telfhash.mjs"
    },
    "./imagehash": {
      "types": "./src/imagehash.d.mts",
      "default": "./src/imagehash.mjs"
    },
    "./minhash": {
      "types": "./src/minhash.d.mts",
      "default": "./src/minhash.mjs"
    },
    "./simhash": {
      "types": "./src/simhash.d.mts",
      "default": "./src/simhash.mjs"
    },
    "./lzjd": {
      "types": "./src/lzjd.d.mts",
      "default": "./src/lzjd.mjs"
    },
    "./nilsimsa": {
      "types": "./src/nilsimsa.d.mts",
      "default": "./src/nilsimsa.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "wasm/",
    "LICENSE",
    "LICENSES/",
    "README.md"
  ]
}
